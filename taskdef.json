{
  "family": "finbert-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024", "memory": "4096",
  "executionRoleArn": "arn:aws:iam::217953193615:role/LabRole",
  "containerDefinitions": [{
    "name": "finbert-api",
    "image": "217953193615.dkr.ecr.us-east-1.amazonaws.com/finbert-api:latest",
    "essential": true,
    "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
    "environment": [{"name": "MODEL_SOURCE", "value": "huggingface"}]
  }]
}
